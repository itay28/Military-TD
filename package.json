{
  "name": "military-td",
  "version": "0.7.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "A basic military-themed tower defense game.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "scenario": "node scripts/scenario.ts",
    "doctor": "node scripts/doctor.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:assets && npm test",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:browser": "playwright test --config playwright.perf.config.ts",
    "credits": "node scripts/credits.ts",
    "check:assets": "node scripts/check-assets.ts",
    "atlas": "node scripts/atlas.ts",
    "ambience-fx": "node scripts/ambience-fx.ts",
    "radio-fx": "node scripts/radio-fx.ts",
    "weapon-fx": "node scripts/weapon-fx.ts",
    "render:pivot": "node scripts/render-pivot.ts",
    "menu:clip": "playwright test --config playwright.menu-clip.config.ts --trace off",
    "itch:shots": "playwright test --config playwright.itch.config.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,html,css}": "prettier --write"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
