{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "workflow@itay28-skills": true,
    "engineering@anthropic-plugin-directory": false,
    "agent-engineering@anthropic-plugin-directory": false
  },
  "extraKnownMarketplaces": {
    "itay28-skills": { "source": { "source": "github", "repo": "itay28/claude-skills" } }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/doctor.ts\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
